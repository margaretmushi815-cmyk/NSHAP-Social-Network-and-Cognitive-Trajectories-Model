. // -- random-effects sheets (one per group) --
. foreach g in low high {
  2.     local G = proper("`g'")
  3.     matrix M = RE_`g'
  4.     putexcel set "`xlfile'", sheet("`G' - Random") modify
  5.     putexcel A1 = ("`G' loneliness group -- random-effects (co)variance")
  6.     local nc = colsof(M)
  7.     local cn : colfullnames M
  8.     forvalues c = 1/`nc' {
  9.         local L : word `c' of `cn'
 10.         local col = char(65 + `c')
 11.         putexcel `col'3 = ("`L'")
 12.     }
 13.     local rn : rowfullnames M
 14.     forvalues r = 1/`nc' {
 15.         local nm : word `r' of `rn'
 16.         local xr = `r' + 3
 17.         putexcel A`xr' = ("`nm'")
 18.         forvalues c = 1/`nc' {
 19.             local col = char(65 + `c')
 20.             putexcel `col'`xr' = (M[`r',`c'])
 21.         }
 22.     }
 23. }
