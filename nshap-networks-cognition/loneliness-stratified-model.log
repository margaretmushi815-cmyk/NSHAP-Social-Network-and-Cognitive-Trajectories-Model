----------------+-----------------------------------
 Low loneliness |      1,291       54.13       54.13
High loneliness |      1,094       45.87      100.00
----------------+-----------------------------------
          Total |      2,385      100.00

. 
. keep su_id loneliness lonely_grp

. tempfile lon

. save "`lon'"
file /var/folders/ng/qfvr38953cs73gt1npzhgd4h0000gn/T//S_89018.000001 saved as .dta format

. 
. //------------------------------------------------------------------------
. // Attach to the analytic long dataset
. //------------------------------------------------------------------------
. use "$datadir/growth_long.dta", clear
(NSHAP W1 core data file (3.0))

. xtset id years

