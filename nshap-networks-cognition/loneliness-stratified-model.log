. //========================================================================
. // Export fixed + random effects for BOTH groups to a 4-sheet workbook:
. //   "Low - Fixed", "High - Fixed", "Low - Random", "High - Random".
. // Uses the FE_/RE_ matrices captured right after each group's mixed
. // command. Written cell-by-cell (robust across Stata versions).
. //========================================================================
. local xlfile "loneliness_stratified_models.xlsx"

. 
. // -- fixed-effects sheets (one per group) --
. local first = 1

. foreach g in low high {
  2.     local G = proper("`g'")
  3.     matrix M = FE_`g'
  4.     if `first' {
  5.         putexcel set "`xlfile'", sheet("`G' - Fixed") replace
  6.         local first = 0
  7.     }
  8.     else {
  9.         putexcel set "`xlfile'", sheet("`G' - Fixed") modify
 10.     }
 11.     putexcel A1 = ("`G' loneliness group -- fixed effects")
 12.     putexcel A3 = ("Parameter")
 13.     putexcel B3 = ("b")
 14.     putexcel C3 = ("SE")
 15.     putexcel D3 = ("z")
 16.     putexcel E3 = ("p")
 17.     putexcel F3 = ("ll (95%)")
 18.     putexcel G3 = ("ul (95%)")
 19.     local fn : rowfullnames M
 20.     local nf = rowsof(M)
 21.     forvalues r = 1/`nf' {
 22.         local nm : word `r' of `fn'
 23.         local xr = `r' + 3
 24.         putexcel A`xr' = ("`nm'")
 25.         putexcel B`xr' = (M[`r',1])
 26.         putexcel C`xr' = (M[`r',2])
 27.         putexcel D`xr' = (M[`r',3])
 28.         putexcel E`xr' = (M[`r',4])
 29.         putexcel F`xr' = (M[`r',5])
 30.         putexcel G`xr' = (M[`r',6])
 31.     }
 32. }
